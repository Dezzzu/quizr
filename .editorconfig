root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yml,yaml,csproj,props,targets,xml}]
indent_size = 2

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.cs]
indent_size = 4
# Must match "printWidth" in .csharpierrc.json — csharpier owns layout,
# this entry only tells the IDE where to draw the guide.
max_line_length = 120

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Prefer var everywhere. A preference, not a rule — severity stays at
# suggestion so the IDE hints and the build never fails on it.
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression-bodied members: fine for one-liners, not for blocks
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Modern C#
csharp_style_pattern_matching_over_is_with_cast_check = true:warning
csharp_style_pattern_matching_over_as_with_null_check = true:warning
csharp_style_prefer_switch_expression = true:suggestion
csharp_style_throw_expression = true:suggestion
csharp_prefer_braces = true:warning
csharp_style_prefer_range_operator = true:suggestion
csharp_style_prefer_collection_expression = true:suggestion
csharp_style_implicit_object_creation_when_type_is_apparent = true:suggestion

# Never primary constructors: their captured parameters cannot be readonly,
# which defeats the rule below. See STYLE.md.
csharp_style_prefer_primary_constructors = false:suggestion

# Fields that never change must say so. Warnings are errors, so the compiler
# finds these instead of a reviewer.
dotnet_style_readonly_field = true:warning

# Seal what isn't designed for inheritance.
dotnet_diagnostic.CA1852.severity = suggestion

# Nullability is not optional here — the roster is full of "maybe" values
dotnet_diagnostic.CS8600.severity = warning
dotnet_diagnostic.CS8602.severity = warning
dotnet_diagnostic.CS8618.severity = warning

# Naming
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_camel.required_prefix = _
dotnet_naming_style.underscore_camel.capitalization = camel_case
