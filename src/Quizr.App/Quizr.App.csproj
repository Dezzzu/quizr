<!-- Sdk.Web, not Sdk: one public endpoint serves the per-player calendar feed
     (docs/CALENDAR.md). The bot itself still long-polls and connects outward. -->
<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Quizr.App</RootNamespace>
        <UserSecretsId>276b7c1f-31d2-42ff-aa8c-bb00176921c2</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Quizr.Domain\Quizr.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\Strings\*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- So internal helpers like CallbackData and CommandText can be tested directly
             rather than only through the router that calls them. -->
        <InternalsVisibleTo Include="Quizr.App.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Telegram.Bot" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="SmartFormat.NET" />
        <PackageReference Include="Ical.Net" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
        <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
        <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
        <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    </ItemGroup>
</Project>
