<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>Quizr.App</RootNamespace>
        <UserSecretsId>276b7c1f-31d2-42ff-aa8c-bb00176921c2</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Quizr.Domain\Quizr.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Localization\Strings\*.json" />
    </ItemGroup>

    <ItemGroup>
        <!-- So internal helpers like CallbackData and CommandText can be tested directly
             rather than only through the router that calls them. -->
        <InternalsVisibleTo Include="Quizr.App.Tests" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Telegram.Bot" />
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="SmartFormat.NET" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    </ItemGroup>
</Project>
