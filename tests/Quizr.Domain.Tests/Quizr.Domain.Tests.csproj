<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <!--
    No NSubstitute here on purpose. Domain logic is pure functions, so these
    tests need no database, no Telegram and no fakes. If a mock ever seems
    necessary, something has leaked into Quizr.Domain that shouldn't be there.
  -->

    <ItemGroup>
        <ProjectReference Include="..\..\src\Quizr.Domain\Quizr.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="AwesomeAssertions" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="TUnit.Core" />
    </ItemGroup>
</Project>
